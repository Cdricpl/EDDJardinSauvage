rules_version = '2';

// ============================================================================
// Regles de securite Firestore - EDD Jardin Sauvage
// ----------------------------------------------------------------------------
// Equivalent des regles RLS utilisees cote Supabase :
//   - LIRE quoi que ce soit exige d'etre MEMBRE (avoir une fiche dans profiles,
//     active, ou etre admin) : etre simplement authentifie ne suffit plus.
//     L'inscription Firebase est ouverte (elle doit l'etre : c'est par elle que
//     l'application cree les comptes), et la configuration du projet est
//     publique. Sans cette regle, n'importe qui pouvait creer un compte et lire
//     les noms, dates de naissance et ecoles des enfants.
//   - les PRESTATIONS ne sont lisibles que par leur employee ou par l'admin
//   - une employee n'ecrit que SES jours, et seulement si le mois est ouvert
//   - les ENFANTS sont visibles et ajoutables par l'equipe ; renommage et
//     retrait sont reserves a l'admin
//   - personne ne peut s'auto-promouvoir administrateur
//   - aucune prestation avant aout 2026
//   - la memoire du pre-encodage suit les memes droits que les presences
//
// A coller dans : console Firebase > Firestore Database > Regles > Publier.
// NB : commentaires volontairement sans accents (l'analyseur de regles
// Firebase echoue sur certains caracteres non-ASCII).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function isAdmin()   { return signedIn() && myProfile().role == 'admin'; }
    function isActive()  { return signedIn() && myProfile().active == true; }
    /* MEMBRE de l'equipe : un compte authentifie NE SUFFIT PAS, il faut une fiche
     * dans profiles. `exists` d'abord : sur un compte sans fiche, `myProfile()`
     * echouerait au lieu de repondre non. L'administration reste membre meme si
     * sa fiche n'etait pas marquee active (on ne se coupe pas l'acces). */
    function membre() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && (myProfile().active == true || myProfile().role == 'admin');
    }

    // "AAAA-MM-JJ" -> "AAAA-MM" (identifiant du document mois)
    function ym(d) { return d.split('-')[0] + '-' + d.split('-')[1]; }

    // Le mois d'une prestation est-il encore modifiable ? (absent = ouvert)
    function monthOpen(emp, d) {
      return !exists(/databases/$(database)/documents/months/$(emp + '_' + ym(d)))
        || get(/databases/$(database)/documents/months/$(emp + '_' + ym(d))).data.status == 'open';
    }

    // Regle metier : le systeme demarre en aout 2026.
    function validDate(d) { return d is string && d.size() == 10 && d >= '2026-08-01'; }

    // ---- PROFILS : sa propre fiche, et celles de l'equipe si on en est ----
    match /profiles/{uid} {
      // Sa PROPRE fiche d'abord : l'application a besoin de la lire pour
      // reconnaitre un compte sans fiche et le dire clairement, au lieu de
      // laisser une erreur de permission a l'ecran. Ce test vient en premier :
      // il ne depend d'aucune lecture, donc il repond meme sans fiche.
      allow read:  if (signedIn() && uid == request.auth.uid) || membre();
      allow write: if isAdmin();
      /* L'AUTO-CREATION DE FICHE A ETE RETIREE. Elle permettait a tout compte
       * authentifie de s'ecrire une fiche "active", et donc d'annuler la
       * regle `membre()` ci-dessus. Les comptes se creent depuis l'onglet
       * Utilisateurs, qui ecrit la fiche au nom de l'administration.
       * Consequence a connaitre : un compte cree DIRECTEMENT dans la console
       * Firebase ne pourra pas se connecter tant que sa fiche n'existe pas. */
    }

    // ---- MOIS : lecture par l'equipe ; seul l'admin valide ou rouvre ----
    match /months/{id} {
      allow read:  if membre();
      allow write: if isAdmin();
    }

    // ---- PRESTATIONS : confidentialite RH ----
    match /day_entries/{id} {
      allow read: if isAdmin()
                  || (membre() && resource.data.employee_id == request.auth.uid);
      allow write: if isAdmin()
                   || (isActive()
                       && request.resource.data.employee_id == request.auth.uid
                       && validDate(request.resource.data.entry_date)
                       && monthOpen(request.auth.uid, request.resource.data.entry_date));
    }

    // ---- HORAIRE TYPE : lecture par l'equipe ; ecriture admin ----
    match /schedule_templates/{empId} {
      allow read:  if membre();
      allow write: if isAdmin();
    }

    // ---- ENFANTS : l'equipe voit et ajoute ; l'admin seul renomme ou retire ----
    match /kids/{id} {
      allow read:   if membre();
      allow create: if isActive();
      allow update, delete: if isAdmin();
    }

    // ---- PRESENCES : encodage quotidien par l'equipe ----
    match /kid_attendance/{id} {
      allow read:  if membre();
      allow write: if isActive();
    }

    // ---- MEMOIRE DU PRE-ENCODAGE : quels mois ont deja ete pre-encodes ----
    // Sans ce marqueur, une case effacee volontairement (3e etat du cycle) serait
    // remise a "present" au chargement suivant. Ecrit par l'equipe, comme les
    // presences : c'est le meme geste d'encodage.
    match /kid_prefill/{id} {
      allow read:  if membre();
      allow write: if isActive();
    }

    // ---- REGLAGES PARTAGES : annee scolaire en cours ----
    // Lisible par toute l'equipe (elle determine ce qui est modifiable),
    // modifiable par la seule administration : ouvrir une nouvelle annee
    // scolaire fige l'annee precedente pour les employees.
    match /settings/{id} {
      allow read:  if membre();
      allow write: if isAdmin();
    }

    // Tout le reste est refuse par defaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
